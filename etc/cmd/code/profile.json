{
  "$schema": "https://nono.sh/schemas/nono-profile.schema.json",
  "meta": {
    "name": "pkio-code",
    "description": "VS Code profile for pkio"
  },
  "groups": {
    "include": [
      "claude_code_linux",
      "claude_cache_linux",
      "vscode_linux",
      "git_config",
      "linux_sysfs_read",
      "nix_runtime",
      "node_runtime",
      "python_runtime",
      "rust_runtime",
      "unlink_protection"
    ]
  },
  "security": {
    "ipc_mode": "full"
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "allow": [
      "/dev/shm",
      "/tmp",
      "/tmp/.X11-unix",
      "/run/user/$UID",
      "$HOME/.config/Code",
      "$HOME/.vscode",
      "$HOME/.vscode-shared",
      "$HOME/.copilot",
      "$HOME/.claude",
      "$HOME/.cache/claude",
      "$HOME/.codex",
      "$HOME/.agents",
      "$HOME/.config/nono/profile-drafts",
      "$HOME/.local/state/claude/locks",
      "$HOME/.cache/fontconfig",
      "$HOME/.cache/Microsoft/DeveloperTools",
      "$HOME/.cache/gtk-3.0",
      "/tmp/claude-$UID"
    ],
    "read": [
      "/proc",
      "/usr/bin",
      "/usr/local/bin",
      "/usr/libexec",
      "/etc/fonts",
      "/var/cache/fontconfig",
      "$HOME/.config/nono/packages",
      "$HOME/.config/nono/profiles",
      "$HOME/.config/gtk-3.0",
      "$HOME/.ssh"
    ],
    "allow_file": [
      "$HOME/.claude.json",
      "$HOME/.claude.json.lock",
      "$HOME/.claude.lock",
      "/dev/ptmx"
    ],
    "read_file": [
      "/etc/gitconfig",
      "/etc/passwd",
      "/etc/shells",
      "$HOME/.XCompose"
    ]
  },
  "open_urls": {
    "allow_origins": [
      "https://auth.openai.com",
      "https://api.anthropic.com",
      "https://claude.ai",
      "https://claude.com",
      "https://platform.claude.com"
    ],
    "allow_localhost": true
  },
  "allow_launch_services": true
}
