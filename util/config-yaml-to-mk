#!/usr/bin/env ys-0

defn main(program *yaml-files):
  say:
    join "\n\n":
      remove falsey?:
        map \(yaml-to-mk(program _)): yaml-files

defn yaml-to-mk(program file):
  when fs-e(file):
    data =: file:load
    when data:
      check-deprecated(data file)
    when data:
      check-profile(data file)
    when data:
      cmd-data =: get-in(data ['cmd' program])
      parts =: data-to-mk(data)
      all =: parts.concat(data-to-mk(cmd-data || {}))
      join "\n\n":
        remove falsey?: all

defn data-to-mk(data):
  list:
    mk-makefile(data)
    mk-browser(data)
    mk-browser-deps(data)
    mk-makes(data)
    mk-path(data)
    mk-env(data)
    mk-cmd-args(data)
    mk-nono-opts(data)

defn check-deprecated(data file):
  when data.dirs:
    die: "'$file' uses 'dirs:' - use 'read-write:' and 'read-only:' instead"
  when data.files:
    die: "'$file' uses 'files:' - use 'read-write:' and 'read-only:' instead"
  p =: get(data 'path')
  when p && p.prepend:
    die: "'$file' uses 'path: prepend:' - use 'path:' with a list instead"

defn check-profile(data file):
  p =: get(data 'profile')
  when p && vector?(p):
    die: "'$file' uses 'profile:' as a list - it must be a string"

defn mk-makefile(data):
  data.makefile

defn mk-browser(data):
  browser =: data.browser
  cond:
    browser == 'google-chrome':: |-
      PKIO-BROWSER-DIR := /tmp/claude-$(shell id -u)
      BROWSER-SHIM := $(PKIO-BROWSER-DIR)/browser-shim
      BROWSER-OPENERS := google-chrome google-chrome-stable xdg-open sensible-browser x-www-browser www-browser gnome-open gio open
      STALE-CLIPBOARD-SHIMS := xclip xsel
      _ := \
      $(shell \
        mkdir -p $(PKIO-BROWSER-DIR) && \
        ( \
          echo '#!/bin/bash'; \
          echo 'set -u'; \
          echo 'log=/tmp/claude-$$(id -u)/browser.log'; \
          echo 'printf "%s %s %q\n" "$$(date +%FT%T%z)" "$$(basename "$$0")" "$$*" >> "$$log"'; \
          echo 'exec /usr/bin/google-chrome --no-sandbox --disable-dev-shm-usage "$$@" >>"$$log" 2>&1' \
        ) > $(BROWSER-SHIM) \
          && chmod +x $(BROWSER-SHIM) \
          && rm -f $(addprefix $(PKIO-BROWSER-DIR)/,$(BROWSER-OPENERS)) \
          && rm -f $(addprefix $(PKIO-BROWSER-DIR)/,$(STALE-CLIPBOARD-SHIMS)) \
          && for opener in $(BROWSER-OPENERS); do \
            ln -sf browser-shim $(PKIO-BROWSER-DIR)/$$opener || exit 1; \
          done \
      )
      PKIO-UNSET-ENV += BROWSER
      PKIO-EXPORT-ENV += PATH=$(PKIO-BROWSER-DIR):$(PATH)

defn mk-browser-deps(data):
  when (data.browser == 'google-chrome') && linux?():
    joins:
      vector:
        mk-entry('--read' '/opt/google/chrome')
        mk-entry('--read' '/dev/dri')
        mk-entry('--allow-unix-socket-dir' '/tmp/.X11-unix')
        mk-entry('--allow' '/run/user/$(shell id -u)')
        mk-entry('--allow-unix-socket' '/run/user/$(shell id -u)/bus')
        mk-entry('--allow-unix-socket-dir' '/run/user/$(shell id -u)')
        mk-entry('--read-file' '/run/user/$(shell id -u)/gdm/Xauthority')
        mk-entry('--read-file' '~/.Xauthority')
        mk-entry('--allow' '/tmp')
        mk-entry('--allow' '~/.config/google-chrome')
        mk-entry('--allow' '~/.local/share/applications')

defn linux?():
  System/getProperty("os.name") == 'Linux'

defn mk-makes(data):
  when data.makes:
    reduce _ '' data.makes:
      fn(o name):
        o + "include \\$(MAKES)/$name.mk\n"

defn mk-path(data):
  p =: get(data 'path')
  when p:
    DBG: "override PATH := $(p.join(':')):\\$(PATH)\nexport PATH"

defn mk-env(data):
  when data.env:
    reduce _ '' data.env:
      fn(o entry):
        o + "PKIO-EXPORT-ENV += $(key entry)=$(val entry)\n"

defn mk-cmd-args(data):
  when data.cmd-args:
    reduce _ '' data.cmd-args:
      fn(o arg):
        o + "PKIO-CMD-ARGS += $arg\n"

defn mk-nono-opts(data):
  str:
    mk-access(data 'read-write' '--allow' '--allow-file')
    mk-access(data 'read-only' '--read' '--read-file')
    mk-net(data)
    mk-profile(data)

defn mk-profile(data):
  p =: get(data 'profile')
  when p:
    mk-entry('--profile' p)

defn mk-net(data):
  when data.net:
    mk-net-inner: data.net

defn mk-net-inner(net):
  str:
    mk-flag-list(net.domains '--allow-domain')
    mk-net-ports(net.ports)

defn mk-net-ports(ports):
  when ports:
    str:
      mk-flag-list(ports.listen '--listen-port')
      mk-flag-list(ports.open '--open-port')

defn mk-access(data key dir-flag file-flag):
  paths =: get(data key)
  when paths:
    reduce _ '' paths:
      fn(o path):
        o +: mk-entry(path-flag(path dir-flag file-flag) path)

defn path-flag(path dir-flag file-flag):
  path-is-file?(path).if(file-flag dir-flag)

defn path-is-file?(path):
  s =: str(path)
  p =: expand-home(s)
  when-not re-find(/\$/ s):
    if fs-e(p):
      not: fs-d(p)
      else:
        ensure-path(p s)

defn ensure-path(p s):
  is-dir =: s.ends?('/')
  if is-dir:
    shell: "mkdir -p '$p'"
    else:
      parent =: p.replace(/[^\/]+$/)
      shell: "mkdir -p '$parent'"
      shell: "touch '$p'"
  not: is-dir

defn expand-home(path):
  home =: System/getenv('HOME')
  if path =~ /^~/:
    then: home + subs(path 1)
    else: path

defn mk-entry(flag val):
  v =: expand-home(str(val))
  =>: "PKIO-NONO-OPTS += $flag $v\n"

defn mk-flag-list(vals flag):
  when vals:
    reduce _ '' vals:
      fn(o val):
        o + mk-entry(flag val)
